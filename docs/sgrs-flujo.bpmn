<bpmn:sequenceFlow id="f15" sourceRef="t10" targetRef="g3"/>
<bpmn:sequenceFlow id="f16" sourceRef="g3" targetRef="t11" name="Interno"/>
<bpmn:sequenceFlow id="f17" sourceRef="g3" targetRef="t12" name="Externo"/>
<bpmn:sequenceFlow id="f18" sourceRef="t11" targetRef="g4"/>
<bpmn:sequenceFlow id="f19" sourceRef="t12" targetRef="g4"/>
<bpmn:sequenceFlow id="f20" sourceRef="g4" targetRef="t13"/>
<bpmn:sequenceFlow id="f21" sourceRef="t13" targetRef="t14"/>
<bpmn:sequenceFlow id="f22" sourceRef="t14" targetRef="e4"/>
</bpmn:process><bpmndi:BPMNDiagram id="d"><bpmndi:BPMNPlane id="pl" bpmnElement="collab">
