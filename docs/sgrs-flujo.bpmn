<bpmn:sequenceFlow id="f8" sourceRef="g2" targetRef="t6" name="No"/>
<bpmn:sequenceFlow id="f9" sourceRef="g2" targetRef="t5" name="Sí"/>
<bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="e2"/>
<bpmn:sequenceFlow id="f11" sourceRef="t5" targetRef="t7"/>
