<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="http://sgrs/bpmn">
<bpmn:collaboration id="collab"><bpmn:participant id="pool" name="SGRS - Ciclo de vida de una rifa" processRef="proc"/></bpmn:collaboration>
<bpmn:process id="proc" isExecutable="false"><bpmn:laneSet id="ls">
<bpmn:lane id="lane_C" name="Comprador"><bpmn:flowNodeRef>s0</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>e1</bpmn:flowNodeRef><bpmn:flowNodeRef>e2</bpmn:flowNodeRef><bpmn:flowNodeRef>e3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_S" name="Sistema (API + worker)"><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>t7</bpmn:flowNodeRef><bpmn:flowNodeRef>s1</bpmn:flowNodeRef><bpmn:flowNodeRef>t9</bpmn:flowNodeRef><bpmn:flowNodeRef>t11</bpmn:flowNodeRef><bpmn:flowNodeRef>g4</bpmn:flowNodeRef><bpmn:flowNodeRef>t13</bpmn:flowNodeRef><bpmn:flowNodeRef>t14</bpmn:flowNodeRef><bpmn:flowNodeRef>e4</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_A" name="Administrador de rifa"><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>b1</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>t10</bpmn:flowNodeRef><bpmn:flowNodeRef>g3</bpmn:flowNodeRef><bpmn:flowNodeRef>t12</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s0" name="Quiere participar"></bpmn:startEvent>
<bpmn:task id="t1" name="Elegir boletas"><bpmn:documentation>Lee: tickets (DISPONIBLE), ticket_numbers</bpmn:documentation></bpmn:task>
<bpmn:task id="t2" name="Reportar pago: n.º transacción y/o comprobante"><bpmn:documentation>Escribe: Idempotency-Key, platform, external_ref, proof_url, amount_declared</bpmn:documentation></bpmn:task>
<bpmn:exclusiveGateway id="g1" name="¿Boletas libres y ventas abiertas?"><bpmn:documentation>Valida: raffles.status/sales_close_at, tickets.status, monto = n x ticket_price, external_ref único</bpmn:documentation></bpmn:exclusiveGateway>
<bpmn:endEvent id="e1" name="Error 409 / 422 / 423"></bpmn:endEvent>
<bpmn:task id="t3" name="Congelar boletas (CONGELADO) y fijar expiración"><bpmn:documentation>UPDATE tickets (atómico); INSERT payment_transactions(PENDING), transaction_tickets, audit_log</bpmn:documentation></bpmn:task>
<bpmn:task id="t4" name="Revisar comprobante"><bpmn:documentation>Lee: payment_transactions PENDING, proof_url (URL firmada)</bpmn:documentation></bpmn:task>
<bpmn:boundaryEvent id="b1" name="Vence hold_minutes" attachedToRef="t4" cancelActivity="true"><bpmn:documentation>expire_holds(): PENDING vencidas -&gt; EXPIRED</bpmn:documentation><bpmn:timerEventDefinition/></bpmn:boundaryEvent>
<bpmn:exclusiveGateway id="g2" name="¿Pago legítimo?"><bpmn:documentation>POST approve / reject</bpmn:documentation></bpmn:exclusiveGateway>
<bpmn:task id="t6" name="Liberar boletas (DISPONIBLE)"><bpmn:documentation>UPDATE tickets; payment_transactions REJECTED/EXPIRED; audit_log</bpmn:documentation></bpmn:task>
<bpmn:endEvent id="e2" name="Boletas disponibles de nuevo"></bpmn:endEvent>
<bpmn:task id="t5" name="Aprobar: boletas PAGADO + encolar notificación"><bpmn:documentation>UPDATE tickets, payment_transactions(APPROVED); INSERT notifications (outbox), audit_log</bpmn:documentation></bpmn:task>
<bpmn:task id="t7" name="Enviar WhatsApp: pago confirmado"><bpmn:documentation>Worker lee notifications QUEUED</bpmn:documentation></bpmn:task>
<bpmn:endEvent id="e3" name="Comprador notificado"></bpmn:endEvent>
<bpmn:startEvent id="s1" name="fecha_cierre_ventas"><bpmn:documentation>auto_close(): raffles OPEN con sales_close_at &lt;= now()</bpmn:documentation><bpmn:timerEventDefinition/></bpmn:startEvent>
<bpmn:task id="t9" name="Bloquear ventas y emitir arqueo contable"><bpmn:documentation>INSERT accounting_closures (vendidos, validado, pendiente, hash); raffles CLOSED</bpmn:documentation></bpmn:task>
<bpmn:task id="t10" name="Resolver transacciones pendientes"><bpmn:documentation>Requisito del sorteo: 0 payment_transactions PENDING</bpmn:documentation></bpmn:task>
<bpmn:exclusiveGateway id="g3" name="¿Método de sorteo?"><bpmn:documentation>raffles.draw_method</bpmn:documentation></bpmn:exclusiveGateway>
<bpmn:task id="t11" name="Interno: CSPRNG elige entre números vendidos"><bpmn:documentation>secrets.randbelow sobre ticket_numbers de boletas PAGADO</bpmn:documentation></bpmn:task>
<bpmn:task id="t12" name="Externo: ingresar n.º oficial + URL de comprobación"><bpmn:documentation>POST draw {winning_number, source_url}</bpmn:documentation></bpmn:task>
<bpmn:exclusiveGateway id="g4" name=""></bpmn:exclusiveGateway>
<bpmn:task id="t13" name="Asignar premios (principal y secos ±offset)"><bpmn:documentation>INSERT draws, winners; tickets GANADOR; raffles DRAWN; audit_log</bpmn:documentation></bpmn:task>
<bpmn:task id="t14" name="Notificar ganadores y al resto"><bpmn:documentation>INSERT notifications WINNER / DRAW_FINISHED</bpmn:documentation></bpmn:task>
<bpmn:endEvent id="e4" name="Sorteo concluido"></bpmn:endEvent>
<bpmn:sequenceFlow id="f0" sourceRef="s0" targetRef="t1"/>
<bpmn:sequenceFlow id="f1" sourceRef="t1" targetRef="t2"/>
<bpmn:sequenceFlow id="f2" sourceRef="t2" targetRef="g1"/>
